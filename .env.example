# Base de datos (datos de salud: fuera del repo).
SALUD_DB_PATH=~/.local/share/salud/salud.db

# Logins de Tailscale que pueden entrar (separados por comas). Vacío: cualquiera
# de la tailnet.
SALUD_USUARIOS=

# Sesión de Garmin (solo tokens, nunca la contraseña). Se crea con
# `salud garmin-entrar`. Para probar se puede apuntar a la de fitness-tracker
# (~/.garminconnect): comparten sesión, como ya hacen sus scripts.
SALUD_GARMIN_TOKENS=~/.local/share/salud/garmin

# Perfil y objetivos para la lectura diaria (formato en perfil.example.toml).
SALUD_PERFIL_PATH=~/.config/salud/perfil.toml

# Lectura diaria con Claude Code (usa la suscripción de quien tenga la sesión
# iniciada en calamar, no la API).
SALUD_CLAUDE=claude
SALUD_LECTURA_MODELO=sonnet
# Si se pone, la lectura puede consultar la nutrición de FatSecret y el
# catálogo de MyWhoosh con el MCP de fitness-tracker, en solo lectura.
SALUD_FITNESS_TRACKER=~/fitness-tracker

# Funciones de IA bajo petición (leer la etiqueta de una foto). Motor "agy"
# (Antigravity CLI, Gemini: no gasta cupo de Claude) o "claude" (claude -p).
SALUD_IA_MOTOR=agy
# SALUD_AGY=~/.local/bin/agy
# SALUD_AGY_TOKEN=~/.gemini/antigravity-cli/antigravity-oauth-token
# SALUD_IA_MODELO_AGY=gemini-3.8-flash-low  (Medium y High tardan más de un minuto a veces)
# SALUD_IA_MODELO_CLAUDE=haiku

# "Dirección secreta en formato iCal" de Configuración del calendario de Google
# con los eventos de deporte. Es un secreto: nunca se comparte ni se guarda en git.
# SALUD_GCAL_ICS=
